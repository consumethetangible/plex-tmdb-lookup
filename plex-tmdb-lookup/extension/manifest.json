{
	"manifest_version": 3,
	"name": "TMDB ID Lookup for Plex",
	"version": "0.1.0",
	"description": "Find TMDB IDs and copy Plex-ready names. Personal tool.",
	"minimum_chrome_version": "110",
	"action": {
		"default_title": "TMDB ID Lookup",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"icons": {
		"16": "icons/icon-16.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"permissions": ["storage"],
	"host_permissions": ["https://api.themoviedb.org/*"],
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Alt+Shift+T"
			},
			"description": "Open TMDB ID Lookup"
		}
	}
}
